
-----------
TABLE LIST
-----------
users
colocations
colocation_user
invitations
categories
expenses
payments
-----------


users
- id (PK)
- name VARCHAR
- email VARCHAR UNIQUE
- email_verified_at TIMESTAMP NULL
- password VARCHAR
- role ENUM('admin','user') DEFAULT 'user'
- reputation INT DEFAULT 0
- is_banned BOOLEAN DEFAULT false
- created_at TIMESTAMP
- updated_at TIMESTAMP

----------------------------

colocations
- id (PK)
- name VARCHAR
- owner_id (FK → users.id)
- status ENUM('active','cancelled') DEFAULT 'active'
- created_at
- updated_at

----------------------------

colocation_user(PIVOT TABLE)
- id (PK)
- user_id (FK → users.id)
- colocation_id (FK → colocations.id)
- joined_at TIMESTAMP
- left_at TIMESTAMP NULL
- created_at
- updated_at

----------------------------

invitations
- id (PK)
- colocation_id (FK → colocations.id)
- email VARCHAR
- token VARCHAR UNIQUE
- status ENUM('pending','accepted','refused') DEFAULT 'pending'
- expires_at TIMESTAMP
- created_at
- updated_at

----------------------------

categories
- id (PK)
- colocation_id (FK → colocations.id)
- name VARCHAR
- created_at
- updated_at

----------------------------

expenses
- id (PK)
- colocation_id (FK → colocations.id)
- category_id (FK → categories.id)
- payer_id (FK → users.id)
- title VARCHAR
- amount DECIMAL(10,2)
- expense_date DATE
- created_at
- updated_at

----------------------------

payments
- id (PK)
- colocation_id (FK → colocations.id)
- from_user_id (FK → users.id)
- to_user_id (FK → users.id)
- amount DECIMAL(10,2)
- paid_at TIMESTAMP
- created_at
- updated_at

----------------------------



rolations(Laravel Eloquent)
----------------------------

User 
hasMany(Expense::class, 'payer_id');
belongsToMany(Colocation::class);
hasMany(Payment::class, 'from_user_id');
hasMany(Payment::class, 'to_user_id');

----------------------------

colocation
belongsTo(User::class, 'owner_id');
belongsToMany(User::class);
hasMany(Expense::class);
hasMany(Category::class);
hasMany(Invitation::class);
hasMany(Payment::class);

----------------------------

expense
belongsTo(User::class, 'payer_id');
belongsTo(Colocation::class);
belongsTo(Category::class);

----------------------------

category
belongsTo(Colocation::class);
hasMany(Expense::class);

----------------------------

payment
belongsTo(User::class, 'from_user_id');
belongsTo(User::class, 'to_user_id');
belongsTo(Colocation::class);

----------------------------

invitation
belongsTo(Colocation::class);

----------------------------
